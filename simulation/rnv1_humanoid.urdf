    <origin xyz="0 0 0.064"/><axis xyz="0 0 1"/>
    <limit lower="-1.309" upper="1.309" effort="0.155" velocity="10.0"/>
    <dynamics damping="0.012" friction="0.002"/>
  </joint>

  <link name="head">
