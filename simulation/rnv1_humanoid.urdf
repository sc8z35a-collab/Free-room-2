<?xml version="1.0"?>
<robot name="rnv1_humanoid">
  <link name="torso">
    <inertial>
      <origin xyz="0.001 0 0.022" rpy="0 0 0"/>
      <mass value="0.20219"/>
      <inertia ixx="0.0001857" ixy="0" ixz="0" iyy="0.0001270" iyz="0" izz="0.0001570"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.026" rpy="0 0 0"/>
      <geometry><box size="0.054 0.080 0.068"/></geometry>
